<Window x:Class="SimpleKanban.Views.SettingsWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="760" Height="460" WindowStartupLocation="CenterOwner" MinWidth="640" MinHeight="400">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <GroupBox Header="Categories" Grid.Column="0" Margin="0,0,8,0">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListBox x:Name="CategoriesListBox"
                         ItemsSource="{Binding Categories}"
                         DisplayMemberPath="Name"
                         SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                         Margin="0,0,0,8" />

                <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,8,0,0">
                    <TextBlock Text="Category Name" FontWeight="SemiBold" />
                    <TextBox Text="{Binding SelectedCategory.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="Add" Click="AddCategoryButton_Click" Width="80" Margin="0,0,8,0" />
                        <Button Content="Remove" Click="RemoveCategoryButton_Click" Width="80" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </GroupBox>

        <GroupBox Header="Tags" Grid.Column="2" Margin="8,0,0,0">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListBox x:Name="TagsListBox"
                         ItemsSource="{Binding AvailableTags}"
                         SelectedItem="{Binding SelectedTag, Mode=TwoWay}"
                         Margin="0,0,0,8">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{Binding Color}" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,0,4" Background="{Binding Color}">
                                <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" />
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,8,0,0">
                    <TextBlock Text="Tag Name" FontWeight="SemiBold" />
                    <TextBox Text="{Binding SelectedTag.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Tag Color" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <TextBox Text="{Binding SelectedTag.Color, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Use a hex color code like #FF95E1D3" FontSize="10" Foreground="#FF666666" Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="Add" Click="AddTagButton_Click" Width="80" Margin="0,0,8,0" />
                        <Button Content="Remove" Click="RemoveTagButton_Click" Width="80" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Click="CancelButton_Click" Width="90" Margin="0,0,8,0" />
            <Button Content="OK" Click="OkButton_Click" Width="90" />
        </StackPanel>
    </Grid>
</Window>