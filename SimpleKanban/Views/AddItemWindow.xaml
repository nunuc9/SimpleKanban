<Window x:Class="SimpleKanban.Views.AddItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add/Edit Item"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        MinWidth="400"
        MinHeight="200">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Title" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox Name="TitleTextBox" />
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Description" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox Name="DescriptionTextBox" AcceptsReturn="True" Height="120" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" Visibility="Collapsed" Margin="0,0,8,0"/>
            <Button Name="CancelButton" Content="Cancel" Click="CancelButton_Click" Margin="0,0,8,0"/>
            <Button Name="OkButton" Content="OK" Click="OkButton_Click" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>