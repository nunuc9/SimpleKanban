# Generic gitignore for .NET project
# Visual Studio / .NET
.vs/
bin/
obj/
*.user
*.suo
*.userosscache
*.sln.docstates

# Rider
.idea/

# Visual Studio Code
.vscode/

# Build outputs
publish/
*.nupkg

# EF Migrations / Local DB / SQLite files you may not want
*.db
*.mdf
*.ldf

# Rider/Resharper
_ReSharper*/
*.DotSettings.user

# User secrets (if used)
secrets.json
