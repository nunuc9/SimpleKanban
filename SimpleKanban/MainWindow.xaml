<Window x:Class="SimpleKanban.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SimpleKanban.ViewModels"
        Title="Simple Kanban" Width="1000" Height="600">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Categories}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" IsItemsHost="True" Margin="12"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#FFCCCCCC" BorderThickness="1" Background="#FFF" Margin="6" Padding="8" Width="240">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Text="{Binding Items.Count, StringFormat=' ({0})'}" FontWeight="Bold" FontSize="14" Foreground="#FF666666"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,6">
                                    <Button Content="Add" Click="AddItem_Click" Tag="{Binding}" Width="60" Margin="0,0,6,0"/>
                                    <Button Content="Edit" Click="EditCategory_Click" Tag="{Binding}" Width="60"/>
                                </StackPanel>
                            </StackPanel>

                            <ListBox ItemsSource="{Binding Items}" Margin="0,6,0,0"
                                     AllowDrop="True"
                                     PreviewMouseLeftButtonDown="ListBox_PreviewMouseLeftButtonDown"
                                     PreviewMouseMove="ListBox_PreviewMouseMove"
                                     Drop="ListBox_Drop">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="ToolTip" Value="ListBoxItem container" />
                                        <EventSetter Event="MouseDoubleClick" Handler="ListBoxItem_MouseDoubleClick" />
                                    </Style>
                                </ListBox.ItemContainerStyle>

                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#FFE0E0E0" BorderThickness="1" Padding="6" Margin="0,0,0,8" Background="#FFF">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12" Foreground="#FF555555" Margin="0,4,0,0"/>
                                                <ItemsControl ItemsSource="{Binding Tags}" Margin="0,6,0,0">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel IsItemsHost="True"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="{Binding Color}" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,4,0" Background="#F9F9F9">
                                                                <TextBlock Text="{Binding Name}" FontSize="10" Foreground="#333"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:G}'}" FontSize="11" Foreground="#FF777777" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</Window>
