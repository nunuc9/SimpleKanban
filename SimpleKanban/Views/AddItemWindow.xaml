<Window x:Class="SimpleKanban.Views.AddItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Item" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner" MinWidth="350">
    <StackPanel Margin="12" Orientation="Vertical" Width="400">
        <TextBlock Text="Title" Margin="0,0,0,4"/>
        <TextBox Name="TitleTextBox" MinWidth="300"/>

        <TextBlock Text="Description" Margin="0,12,0,4"/>
        <TextBox Name="DescriptionTextBox" MinHeight="80" TextWrapping="Wrap" AcceptsReturn="True"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Name="CancelButton" Width="75" Margin="4,0" Click="CancelButton_Click">Cancel</Button>
            <Button Name="OkButton" Width="75" Margin="4,0" Click="OkButton_Click">OK</Button>
        </StackPanel>
    </StackPanel>
</Window>